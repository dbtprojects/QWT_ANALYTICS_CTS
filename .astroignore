# Astro ignore file - files to exclude from deployment
# Similar to .gitignore but for Astro deploys

# dbt build artifacts
target/
dbt_packages/
dbt_modules/
logs/

# Documentation (optional - remove these lines if you want to include docs)
*.md
!README.md

# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
